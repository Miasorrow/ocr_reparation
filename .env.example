# À exporter dans le shell ; le projet ne charge pas automatiquement ce fichier.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0
TESSERACT_LANG=fra
TESSERACT_TIMEOUT_SECONDS=60
OCR_MAX_BYTES=10485760
OCR_MAX_PIXELS=25000000
# OCR_DB_PATH=/chemin/local/ocr_evaluation.sqlite3
# OCR_IMAGE_DIR=/chemin/local/images
TESSERACT_AUTO_ROTATE=1
TESSERACT_ORIENTATION_CONFIDENCE=4
